---
import { getFeed, fmtDate, BYLINE } from "../../lib/wx";

const feed = await getFeed();
const byMonth = new Map<string, typeof feed.posts>();
for (const p of feed.posts) {
  const key = (p.forDate || "").slice(0, 7);
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key)!.push(p);
}
const months = [...byMonth.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const monthName = (k: string) =>
  k ? new Date(`${k}-02T12:00:00Z`).toLocaleDateString("en-US",
      { month: "long", year: "numeric", timeZone: "UTC" }) : "Undated";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Forecast archive | {BYLINE}</title>
  <meta name="description" content="Every forecast published for Vallecito Lake, Bayfield and Durango, by month." />
  <link rel="canonical" href="https://govallecito.com/weather/archive/" />
</head>
<body>
<main class="wx">
  <p class="wx-crumb"><a href="/weather/">{BYLINE}</a></p>
  <h1>Archive</h1>
  {feed.count === 0 && <p>Nothing published yet.</p>}
  {months.map(([key, posts]) => (
    <section>
      <h2>{monthName(key)}</h2>
      <ul>
        {posts.map((p) => (
          <li>
            <a href={`/weather/${p.slug}/`}>{p.title}</a>
            <span class="wx-date"> · {fmtDate(p.forDate)}</span>
            {p.snowLineFt && <span class="wx-sl"> · snow line {p.snowLineFt.toLocaleString()} ft</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
  {feed.truncated && (
    <p class="wx-note">
      Older forecasts than these are kept as files in the
      <a href="https://github.com/GoVallecito/govallecito-bot/tree/main/site/weather" rel="noopener"> public archive</a>.
    </p>
  )}
</main>
</body>
</html>
