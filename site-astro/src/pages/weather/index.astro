---
// The landing page.
//
// The forecast sits inside <div id="wx-live">. That id is load-bearing: the
// Pages Function at functions/weather/index.ts finds it and swaps in the
// current forecast at request time, so this page is right at 6am even though
// the site itself only rebuilds every few hours. If the id is renamed or
// removed, the function silently stops updating and this built version is what
// visitors see, which is a graceful failure but a stale one.
//
// Swap the <html>/<head> below for your site Layout component when you drop
// this in. Everything inside <main> is the part that matters.
import { getFeed, describe, fmtDate, postToHtml, BYLINE } from "../../lib/wx";

const feed = await getFeed();
const [latest, ...rest] = feed.posts;
const recent = rest.slice(0, 10);
const canonical = new URL("/weather/", Astro.site ?? "https://govallecito.com");
const description = latest
  ? describe(latest)
  : "Forecast by elevation for Vallecito Lake, Bayfield and Durango. Snow line in feet.";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{latest ? `${latest.title} | ${BYLINE}` : `${BYLINE} | Vallecito, Bayfield, Durango`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <link rel="alternate" type="application/rss+xml" title={BYLINE} href="/weather/rss.xml" />
</head>
<body>
<main class="wx">
  <header class="wx-head">
    <h1 class="wx-brand">{BYLINE}</h1>
    <p class="wx-tagline">
      Forecast by elevation for Vallecito Lake, Bayfield and Durango. The snow
      line in feet, because the Durango forecast is not the Vallecito forecast.
    </p>
  </header>

  <div id="wx-live"
       data-wx-generated={latest?.date ?? ""}
       data-wx-source="build"
       set:html={latest ? postToHtml(latest, "h1") : `<p class="wx-empty">No forecast is published yet. Live conditions are on the <a href="/conditions">conditions page</a>.</p>`} />

  {recent.length > 0 && (
    <section class="wx-recent">
      <h2>Recent</h2>
      <ul>
        {recent.map((p) => (
          <li>
            <a href={`/weather/${p.slug}/`}>{p.title}</a>
            <span class="wx-date"> · {fmtDate(p.forDate)}</span>
          </li>
        ))}
      </ul>
      <p><a href="/weather/archive/">Every forecast</a> · <a href="/weather/record/">Track record</a></p>
    </section>
  )}
</main>
</body>
</html>
